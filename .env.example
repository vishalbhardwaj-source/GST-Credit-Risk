# TinyFish AI Web Agent Configuration
# Optional: If omitted, the engine uses deterministic live-parity mock fallbacks with SQLite caching
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0

# Render Keep-Alive / Sleep Prevention Configuration
KEEP_ALIVE=true
KEEP_ALIVE_URL=https://gst-credit-risk-api.onrender.com
KEEP_ALIVE_INTERVAL_MINUTES=10

# Frontend Configuration
VITE_API_URL=http://localhost:8000
