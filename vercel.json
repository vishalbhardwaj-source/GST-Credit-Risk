{
  "buildCommand": "npm --prefix vite-app install && npm --prefix vite-app run build",
  "outputDirectory": "vite-app/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
